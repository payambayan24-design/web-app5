{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app5",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "5a0f9dba-4851-4ecf-bb83-7a70f79e70ea","database_name": "web-app5" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "8bbc9c7ad2d04c538361aebefc740385" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
